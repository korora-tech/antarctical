---
interface Props {
  title: string;
  description: string;
  updated?: string;
}

const { title, description, updated } = Astro.props;
const fullTitle = title === "Antarctical" ? title : `${title} · Antarctical`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  </head>
  <body>
    <header>
      <a class="brand" href="/">
        <img src="/favicon.svg" alt="" width="24" height="24" />
        Antarctical
      </a>
      <nav>
        <a href="/privacy-policy">Privacy</a>
        <a href="/terms-of-service">Terms</a>
      </nav>
    </header>
    <main>
      <h1>{title === "Antarctical" ? "Antarctical" : title}</h1>
      {updated && <p class="updated">Last updated {updated}</p>}
      <slot />
    </main>
    <footer>
      <p>
        Antarctical is made by P4X-639 Ltd, trading as Rawkode Academy ·
        <a href="mailto:david@rawkode.academy">david@rawkode.academy</a>
      </p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #ffffff;
    --surface: #f5f7fb;
    --text: #1a1f2b;
    --muted: #5b6475;
    --border: #e2e6ee;
    --accent: #2563eb;
    color-scheme: light dark;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0f131a;
      --surface: #171c25;
      --text: #e6e9ef;
      --muted: #9aa3b5;
      --border: #262d3a;
      --accent: #7aa7ff;
    }
  }
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font:
      17px/1.65 system-ui,
      -apple-system,
      "Segoe UI",
      sans-serif;
  }
  header,
  main,
  footer {
    max-width: 44rem;
    margin: 0 auto;
    padding: 0 16px;
  }
  header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.25rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--border);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 650;
    color: var(--text);
    text-decoration: none;
  }
  nav {
    display: flex;
    gap: 1.25rem;
  }
  nav a {
    color: var(--muted);
    text-decoration: none;
  }
  nav a:hover {
    color: var(--text);
  }
  main {
    padding-top: 2.5rem;
    padding-bottom: 3rem;
  }
  h1 {
    font-size: 2.1rem;
    line-height: 1.2;
    margin: 0 0 0.5rem;
  }
  h2 {
    font-size: 1.25rem;
    margin: 2.25rem 0 0.5rem;
  }
  .updated {
    color: var(--muted);
    margin-top: 0;
  }
  a {
    color: var(--accent);
  }
  li + li {
    margin-top: 0.35rem;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
    display: block;
    overflow-x: auto;
  }
  th,
  td {
    text-align: left;
    vertical-align: top;
    padding: 0.5rem 0.75rem;
    border-bottom: 1px solid var(--border);
  }
  th {
    background: var(--surface);
  }
  code {
    font-size: 0.9em;
    background: var(--surface);
    padding: 0.1em 0.35em;
    border-radius: 4px;
    overflow-wrap: anywhere;
  }
  .callout {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1rem 1.25rem;
  }
  footer {
    padding-top: 1.5rem;
    padding-bottom: 2.5rem;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.9rem;
  }
</style>
